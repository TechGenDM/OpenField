# Local Ollama endpoint (Ollama must be running on your local machine)
OLLAMA_HOST=http://localhost:11434

# Active local model name
# - gemma4:e4b : Recommended default (balanced speed and multimodal vision debrief)
# - gemma4:e2b : Fallback model for lower-resource machines or CPU-only setups
# - gemma4:12b : Optional benchmarking only (requires substantial GPU VRAM/RAM)
OPENFIELD_MODEL=gemma4:e4b
